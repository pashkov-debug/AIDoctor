{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aidoctor/clinical_response.v1.schema.json",
  "title": "AIDoctor Clinical Response v1 (design contract, not wired to API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "provenance",
    "assessment",
    "history_draft",
    "medication_proposals",
    "observations",
    "alerts",
    "referrals",
    "workflow",
    "display"
  ],
  "properties": {
    "schema_version": {
      "const": "aidoctor_clinical_response.v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 3
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "request_id",
        "patient_id",
        "context_sha256",
        "orders_sha256",
        "evidence_status"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "patient_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "orders_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_status": {
          "const": "unverified_ai"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_code",
        "hypothesis",
        "confidence_percent",
        "confidence_kind",
        "risk_level",
        "therapy_evidence"
      ],
      "properties": {
        "diagnosis_code": {
          "type": "string"
        },
        "hypothesis": {
          "type": "string"
        },
        "confidence_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "confidence_kind": {
          "enum": [
            "illustrative_not_calibrated",
            "not_estimated"
          ]
        },
        "risk_level": {
          "enum": [
            "routine",
            "review",
            "urgent",
            "emergency",
            "unknown"
          ]
        },
        "therapy_evidence": {
          "enum": [
            "high",
            "medium",
            "limited",
            "not_assessed"
          ]
        }
      }
    },
    "history_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjective",
        "objective",
        "assessment",
        "plan",
        "status"
      ],
      "properties": {
        "subjective": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "assessment": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "status": {
          "const": "draft_requires_review"
        }
      }
    },
    "medication_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredient",
          "brand",
          "action",
          "dose_mg",
          "frequency_per_day",
          "route",
          "duration_days",
          "verification",
          "status",
          "reason"
        ],
        "properties": {
          "ingredient": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "action": {
            "enum": [
              "continue_existing",
              "review_hold",
              "review_change",
              "none"
            ]
          },
          "dose_mg": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "frequency_per_day": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "route": {
            "enum": [
              "oral",
              "unknown"
            ]
          },
          "duration_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "verification": {
            "enum": [
              "source_case_only",
              "needs_grls_check",
              "not_applicable"
            ]
          },
          "status": {
            "const": "pending_physician_approval"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "value",
          "unit",
          "source",
          "record_status"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "enum": [
              "case_data",
              "branch_simulation"
            ]
          },
          "record_status": {
            "const": "unverified_draft"
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "reason_code",
          "message",
          "requires_acknowledgement",
          "dispatch"
        ],
        "properties": {
          "priority": {
            "enum": [
              "standard",
              "urgent",
              "emergency"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requires_acknowledgement": {
            "type": "boolean"
          },
          "dispatch": {
            "const": "proposed_not_sent"
          }
        }
      }
    },
    "referrals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specialty",
          "priority",
          "reason",
          "status"
        ],
        "properties": {
          "specialty": {
            "enum": [
              "psychiatrist",
              "emergency_services",
              "other"
            ]
          },
          "priority": {
            "enum": [
              "desirable",
              "mandatory",
              "emergency"
            ]
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "const": "proposed_requires_clinician"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_physician_approval",
        "auto_apply_orders",
        "auto_publish_history",
        "backend_should_run_safety_rules"
      ],
      "properties": {
        "requires_physician_approval": {
          "const": true
        },
        "auto_apply_orders": {
          "const": false
        },
        "auto_publish_history": {
          "const": false
        },
        "backend_should_run_safety_rules": {
          "const": true
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physician",
        "patient"
      ],
      "properties": {
        "physician": {
          "type": "string"
        },
        "patient": {
          "type": "string"
        }
      }
    }
  }
}
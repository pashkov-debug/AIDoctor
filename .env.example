APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://aidoctor:aidoctor_dev@127.0.0.1:5432/aidoctor
ATTACHMENTS_DIR=data/attachments
LLM_API_KEY=

# Включает только внутренний канал; дополнительно требуется CLI --once.
SAFETY_IN_APP_DELIVERY_ENABLED=false

# Ручной запуск административного follow-up; без автоматической рассылки.
SAFETY_FOLLOWUP_SCAN_ENABLED=false

# 6.3.1: только ручная AV-диагностика. Требуется реальный clamd на 127.0.0.1:3310.
ATTACHMENT_CLAMD_ENABLED=false

# UI-4B: ТОЛЬКО для локальных синтетических пациентов; выключено по умолчанию.
AIDOCTOR_ALLOW_SYNTHETIC_AI_DRAFTS=0

# DEMO AI-1: только тестовый сервер и синтетические пациенты.
# Заполнить в /opt/aidoctor/git-checkout/.env.test, НЕ коммитить секрет.
AIDOCTOR_DEMO_CALLBACK_ENABLED=0
AIDOCTOR_SITE_BRIDGE_TOKEN=
# AI-3: доступ внешнего Site для нескольких врачей, только TEST.
# Ключ каждого врача создаётся CLI, не помещается в этот файл.
AIDOCTOR_SITE_MULTI_DOCTOR_ENABLED=0
# Реальные/несинтетические кейсы выключены до проверки согласия и защиты данных.
AIDOCTOR_SITE_ALLOW_NON_SYNTHETIC=0

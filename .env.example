APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://aidoctor:aidoctor_dev@127.0.0.1:5432/aidoctor
ATTACHMENTS_DIR=data/attachments
LLM_API_KEY=

# Включает только внутренний канал; дополнительно требуется CLI --once.
SAFETY_IN_APP_DELIVERY_ENABLED=false

# Ручной запуск административного follow-up; без автоматической рассылки.
SAFETY_FOLLOWUP_SCAN_ENABLED=false

# 6.3.1: только ручная AV-диагностика. Требуется реальный clamd на 127.0.0.1:3310.
ATTACHMENT_CLAMD_ENABLED=false

# Отдельный демонстрационный процесс (НЕ рабочая БД; не используется FastAPI).
# Установить в PowerShell до demo_bridge.seed / uvicorn. Не коммитить секреты!
AIDOCTOR_DEMO_DB_URL=

{
    admin off
}

# Сертификат выпускается и продлевается Caddy, только если DNS указывает на VDS.
{$AIDOCTOR_PUBLIC_DOMAIN} {
    encode zstd gzip

    @hidden {
        path /docs /docs/* /redoc /redoc/* /openapi.json /api/v1/health
    }
    respond @hidden 404

    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    reverse_proxy app:8000
}

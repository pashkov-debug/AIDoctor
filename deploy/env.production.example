# Скопировать в КОРЕНЬ проекта как .env.production.
# Для первого теста конфигурация доступна только на localhost самой ВМ.
# Пустой пароль гарантированно запрещает запуск Compose до настройки.\n# DB_PASSWORD: URL-безопасная строка из букв/цифр/дефисов/подчёркиваний.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
DB_PASSWORD=
AIDOCTOR_DOMAIN=localhost
BIND_ADDRESS=127.0.0.1

# Публичное включение ТОЛЬКО после отдельного решения по безопасности:
# AIDOCTOR_DOMAIN=your-controlled-domain.example
# BIND_ADDRESS=0.0.0.0
